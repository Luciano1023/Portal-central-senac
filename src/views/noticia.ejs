<%- include("Partials/header") %>

<main class="home">

    <!-- HERO -->
    <section class="hero">

        <div class="hero-text">

            <span class="hero-tag">
                CENTRAL SENAC
            </span>

            <h1>
                Informação que acontece dentro da nossa escola.
            </h1>

            <p>
                Acompanhe as principais notícias e acontecimentos
                do cotidiano do SENAC.
            </p>

        </div>

    </section>


    <% if (noticias && noticias.length > 0) { %>

        <!-- DESTAQUE -->
        <section class="featured-section">

            <div class="section-heading">
                <span></span>
                <h2>Notícia em destaque</h2>
            </div>

            <article class="featured-news">

                <div class="featured-image">

                    <img
                        src="<%= noticias[0].getImagem() %>"
                        alt="<%= noticias[0].getTitulo() %>"
                    >

                </div>

                <div class="featured-content">

                    <span class="news-label">
                        DESTAQUE
                    </span>

                    <h2>
                        <%= noticias[0].getTitulo() %>
                    </h2>

                    <p>
                        <%= noticias[0].getConteudo() %>
                    </p>

                    <a
                        href="/noticias/<%= noticias[0].getId() %>"
                        class="read-more"
                    >
                        Ler matéria
                        <span>→</span>
                    </a>

                </div>

            </article>

        </section>


        <!-- ÚLTIMAS NOTÍCIAS -->
        <section class="latest-news">

            <div class="section-heading">

                <span></span>

                <h2>
                    Últimas notícias
                </h2>

            </div>


            <div class="news-grid">

                <% noticias.slice(1).forEach(function(noticia){ %>

                    <article class="news-card">

                        <div class="news-card-image">

                            <img
                                src="<%= noticia.getImagem() %>"
                                alt="<%= noticia.getTitulo() %>"
                            >

                        </div>

                        <div class="news-card-content">

                            <span class="news-label">
                                NOTÍCIA
                            </span>

                            <h3>
                                <%= noticia.getTitulo() %>
                            </h3>

                            <p>
                                <%= noticia.getConteudo() %>
                            </p>

                            <a
                                href="/noticias/<%= noticia.getId() %>"
                                class="read-more"
                            >
                                Ler matéria
                                <span>→</span>
                            </a>

                        </div>

                    </article>

                <% }) %>

            </div>

        </section>


    <% } else { %>

        <section class="empty-news">

            <div class="empty-icon">
                📰
            </div>

            <h2>
                Nenhuma notícia disponível
            </h2>

            <p>
                Ainda não existem notícias cadastradas no Central Senac.
            </p>

        </section>

    <% } %>

</main>

<%- include("Partials/footer") %>