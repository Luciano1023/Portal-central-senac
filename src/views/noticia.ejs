<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Central Senac</title>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header>
    <h1>📰 Central Senac</h1>

    <nav>
        <ul>
            <li><a href="/">Início</a></li>
            <li><a href="/categorias">Categorias</a></li>
            <li><a href="/receitas">Notícias</a></li>
            <li><a href="/usuarios">Usuários</a></li>
        </ul>
    </nav>
</header>

<main class="container">

    <h2>Últimas Notícias</h2>

    <% if (noticias && noticias.length > 0) { %>

        <div class="cards">

            <% noticias.forEach(function(noticia){ %>

                <div class="card">

                    <img
                        src="<%= noticia.getImagem() %>"
                        alt="<%= noticia.getTitulo() %>"
                    >

                    <div class="card-content">

                        <h2><%= noticia.getTitulo() %></h2>

                        <p>
                            <%= noticia.getConteudo() %>
                        </p>

                        <a href="/noticias/<%= noticia.getId() %>">
    Ler notícia
</a>
                        </a>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } else { %>

        <div class="card">

            <div class="card-content">

                <h2>Bem-vindo ao Central Senac</h2>

                <p>
                    Ainda não existem notícias cadastradas.
                </p>

            </div>

        </div>

    <% } %>

</main>

<footer>
    <p>© 2026 - Portal Central Senac</p>
</footer>

</body>
</html>
