<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuários - Central Senac</title>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header>

    <div class="logo">
        📰 <span>Central Senac</span>
    </div>

    <nav>
        <ul>
            <li><a href="/">Início</a></li>
            <li><a href="/noticias">Notícias</a></li>
            <li><a href="/categorias">Categorias</a></li>
            <li><a href="/usuarios">Usuários</a></li>
        </ul>
    </nav>

</header>

<main class="container">

    <h2>Cadastrar Usuário</h2>

    <form action="/usuarios" method="POST" class="formulario">

        <label>Nome</label>
        <input
            type="text"
            name="nome"
            placeholder="Digite o nome"
            required
        >

        <label>E-mail</label>
        <input
            type="email"
            name="email"
            placeholder="Digite o e-mail"
            required
        >

        <label>Senha</label>
        <input
            type="password"
            name="senha"
            placeholder="Digite a senha"
            required
        >

        <button type="submit">
            Cadastrar
        </button>

    </form>

    <h2>Usuários Cadastrados</h2>

    <% if (usuarios && usuarios.length > 0) { %>

        <div class="cards">

            <% usuarios.forEach(function(usuario){ %>

                <div class="card">

                    <div class="card-content">

                        <h3><%= usuario.getNome() %></h3>

                        <p>
                            <strong>E-mail:</strong>
                            <%= usuario.getEmail() %>
                        </p>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } else { %>

        <div class="card">

            <div class="card-content">

                <h3>Nenhum usuário cadastrado</h3>

                <p>
                    Cadastre um usuário utilizando o formulário acima.
                </p>

            </div>

        </div>

    <% } %>

</main>

<footer>

    <p>© 2026 - Portal Central Senac</p>

</footer>

</body>
</html>